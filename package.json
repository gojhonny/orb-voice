{
  "name": "orbu",
  "version": "1.1.1",
  "description": "Orbu is a framework-agnostic, customizable AI voice orb built as a strict, SSR-safe web component.",
  "type": "module",
  "license": "MIT",
  "author": "gojhonny",
  "main": "./dist/orbu.js",
  "module": "./dist/orbu.js",
  "types": "./dist/orbu.d.ts",
  "unpkg": "./dist/standalone/orbu.js",
  "jsdelivr": "./dist/standalone/orbu.js",
  "bin": {
    "orbu": "./cli/orbu"
  },
  "files": [
    "dist",
    "cli"
  ],
  "packageManager": "pnpm@10.32.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gojhonny/orbu.git"
  },
  "bugs": {
    "url": "https://github.com/gojhonny/orbu/issues"
  },
  "homepage": "https://neongate.com.br/docs/orbz/overview",
  "keywords": [
    "ai-voice",
    "voice-ui",
    "framework-agnostic",
    "react",
    "angular",
    "svelte",
    "vue",
    "ssr",
    "microfrontend",
    "web-components",
    "custom-elements"
  ],
  "scripts": {
    "pnpm:devPreinstall": "./cli/orbu setup --launcher --bootstrap",
    "setup": "./cli/orbu setup --launcher",
    "prepack": "./cli/orbu check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "20.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "semver": "7.8.5",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/orbu.d.ts",
      "import": "./dist/orbu.js",
      "default": "./dist/orbu.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./react-types": {
      "types": "./dist/react-types.d.ts",
      "import": "./dist/react-types.js",
      "default": "./dist/react-types.js"
    },
    "./standalone": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/standalone/orbu.js",
      "default": "./dist/standalone/orbu.js"
    },
    "./index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/browser.js",
    "./dist/index.css",
    "./dist/standalone/orbu.js"
  ],
  "engines": {
    "node": "24.x"
  }
}
