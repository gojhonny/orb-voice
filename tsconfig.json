{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@core/*": [
        "./src/core/*"
      ],
      "@element/*": [
        "./src/element/*"
      ],
      "@factories/*": [
        "./src/factories/*"
      ],
      "@orbu": [
        "./src/index.ts"
      ],
      "@ports/*": [
        "./src/ports/*"
      ],
      "@services/*": [
        "./src/services/*"
      ],
      "@talk/*": [
        "./src/talk/*"
      ],
      "@configuration": [
        "./src/orbu.config.json"
      ]
    },
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.json"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
